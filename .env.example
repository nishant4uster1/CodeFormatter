# ---- Required Next.js scaffolding ----
MONGO_URL=mongodb://localhost:27017/codeformatter
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---- Google AdSense (optional) ----
# 1. Sign up / sign in at https://www.google.com/adsense
# 2. Add your site → wait for approval.
# 3. Copy your publisher ID (looks like: ca-pub-1234567890123456) and paste below.
#    Leaving this blank simply hides ads and shows dev-only placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT=

# For each of the four ad slots the site provides:
#   Ads → By ad unit → Create new ad unit → Display ad → copy the 10-digit "data-ad-slot".
NEXT_PUBLIC_ADSENSE_SLOT_HERO=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INCONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
